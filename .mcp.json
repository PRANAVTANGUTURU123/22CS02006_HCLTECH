{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chrome",
        "--isolated",
        "--output-dir",
        ".playwright-mcp"
      ]
    },
    "cold-chain": {
      "command": ".venv/Scripts/python.exe",
      "args": [
        "-m",
        "backend.mcp_server"
      ]
    }
  }
}
