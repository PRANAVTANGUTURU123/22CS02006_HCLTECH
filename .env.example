# Copy to .env (Copy-Item .env.example .env) and fill in locally. Never commit .env.
# Every value here can also be set as a cloud app setting / environment variable.

# ---- App ----
APP_NAME=hackathon-starter
ENVIRONMENT=local
LOG_LEVEL=INFO
# true = JSON log lines (use in the cloud), false = readable console logs
LOG_JSON=false
REQUEST_TIMEOUT_SECONDS=30
# JSON list. Only needed if the frontend is served from a different origin.
CORS_ORIGINS=[]

# ---- Storage ----
# Leave unset to use ./data/app.db. On Azure App Service use: sqlite:////home/data/app.db
# DATABASE_URL=sqlite:///./data/app.db

# ---- LLM ----
# mock | groq | gemini. "mock" needs no key and is the safe default.
LLM_PROVIDER=mock
# Used if the primary fails (rate limit, timeout, outage, bad config). Blank = no fallback.
LLM_FALLBACK_PROVIDER=
LLM_TIMEOUT_SECONDS=20
# Retries for timeouts/5xx only. 429 rate limits are not retried; they go to the fallback.
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2

# Groq: create a key at https://console.groq.com/keys
# Current production models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# For reasoning models (openai/gpt-oss-*): low | medium | high. Leave blank for llama models.
GROQ_REASONING_EFFORT=low

# Gemini: create a key at https://aistudio.google.com/apikey
# Current models: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
