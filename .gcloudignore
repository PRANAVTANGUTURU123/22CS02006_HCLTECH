# Files NOT uploaded by `gcloud run deploy --source .`
# This file replaces .gitignore for gcloud, so frontend/dist IS uploaded even though Git ignores it.
.gcloudignore
.git/
.gitignore
.env
.env.*
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
data/
deploy/
tests/
frontend/node_modules/
frontend/src/
requirements-dev.txt
requirements-search.txt
*.db
